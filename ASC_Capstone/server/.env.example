# ASC_Capstone server environment.
# Every variable read by src/config/env.ts is listed here, in the order it is
# declared there. The schema is parsed at import time and the process exits 1 if
# it fails, so a missing required value is a startup crash, not a runtime one.
# Copy to .env and fill in the two required values.

# Runtime mode: development | test | production. Optional, defaults to development.
NODE_ENV=development

# Port the HTTP server listens on. Optional, defaults to 3000.
# The Android app reaches it over `adb reverse tcp:3000 tcp:3000`.
PORT=3000

# REQUIRED. PostgreSQL connection string used by Prisma. The local dev database
# is the `capstone-db` Docker container, published on 5433.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/capstone?schema=public

# REQUIRED. Signing key for auth tokens. Must be at least 16 characters.
JWT_SECRET=replace-me-with-a-long-random-string

# Token lifetime, in the string form jsonwebtoken accepts. Optional, defaults to 1d.
JWT_EXPIRES_IN=1d

# Score above which grading.service.ts labels a grade local_model rather than
# frontier_api. 0..1, optional, defaults to 0.8. Read by that one service only,
# which nothing currently imports.
CONFIDENCE_THRESHOLD=0.8

# Base URL of the teacher worksheet system (v-2.1.1, FastAPI). Read only by
# POST /api/assignments/import. Optional, defaults to http://localhost:8000 —
# and it is unset in the current .env, so the default is what every import would
# use today. Point this at the teammate's server before importing.
TEACHER_API_BASE_URL=http://localhost:8000

# Timeout for that fetch, in milliseconds. Optional, defaults to 10000.
# A timeout surfaces as a 502 from the import route.
TEACHER_API_TIMEOUT_MS=10000

# Set to the literal string "false" to make POST /api/auth/register reject
# self-registering students with a 403. Any other value, or unset, allows it.
STUDENT_SELF_REGISTER=true
